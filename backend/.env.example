PORT=5000
NODE_ENV=development
MONGODB_URI=memory
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace_with_a_random_32_plus_character_access_secret
JWT_REFRESH_SECRET=replace_with_a_random_32_plus_character_refresh_secret
MFA_ENCRYPTION_KEY=replace_with_a_random_32_plus_character_mfa_key
# Email (Resend) — used for auth + order notifications
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Brynoxa <orders@your-verified-domain.com>
# New COD orders are emailed here (plus customer status emails when Resend is configured)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace_with_a_unique_12_plus_character_password
