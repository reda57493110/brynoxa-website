PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/brynoxa
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace_with_a_random_32_plus_character_access_secret
JWT_REFRESH_SECRET=replace_with_a_random_32_plus_character_refresh_secret
MFA_ENCRYPTION_KEY=replace_with_a_random_32_plus_character_mfa_key
# How long a sign-in lasts (optional)
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Product photos on Cloudinary (optional; without it photos are stored in MongoDB)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Database size limit of your MongoDB Atlas plan in MB, for Admin → Settings → Storage (free M0 plan: 512)
# STORAGE_LIMIT_MB=512
# Email (Resend) — used for auth + order notifications
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Brynoxa <orders@your-verified-domain.com>
# New COD orders are emailed here (plus customer status emails when Resend is configured)
ADMIN_EMAIL=owner@your-domain.com

# Browser push notifications — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@your-domain.com
ADMIN_PASSWORD=replace_with_a_unique_12_plus_character_password
