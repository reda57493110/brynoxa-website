{
  "framework": "vite",
  "installCommand": "npm install --include=dev && npm install --prefix backend --include=dev && npm install --prefix frontend --include=dev",
  "buildCommand": "npm run build --prefix backend && npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/api/v1/db-ping", "destination": "/api/v1/health?__resource=db-ping" },
    { "source": "/api/v1/brands", "destination": "/api/v1/categories?__resource=brands" },
    { "source": "/api/v1/brands/(.*)", "destination": "/api/v1/categories?__resource=brands&__route=$1" },
    { "source": "/api/v1/notifications", "destination": "/api/v1/wishlist?__resource=notifications" },
    { "source": "/api/v1/notifications/(.*)", "destination": "/api/v1/wishlist?__resource=notifications&__route=$1" },
    { "source": "/api/v1/admin/(.*)", "destination": "/api/v1/admin?__route=$1" },
    { "source": "/api/v1/products/(.*)", "destination": "/api/v1/products?__route=$1" },
    { "source": "/api/v1/categories/(.*)", "destination": "/api/v1/categories?__route=$1" },
    { "source": "/api/v1/orders/(.*)", "destination": "/api/v1/orders?__route=$1" },
    { "source": "/api/v1/coupons/validate", "destination": "/api/v1/orders?__route=coupons/validate" },
    { "source": "/api/v1/wishlist/(.*)", "destination": "/api/v1/wishlist?__route=$1" },
    { "source": "/api/v1/newsletter", "destination": "/api/v1/contact?__route=newsletter" },
    { "source": "/api/v1/reviews/(.*)", "destination": "/api/v1/reviews?__route=$1" },
    { "source": "/api/v1/auth/me/(.*)", "destination": "/api/v1/auth?__route=me/$1" },
    { "source": "/api/v1/auth/password-reset/(.*)", "destination": "/api/v1/auth?__route=password-reset/$1" },
    { "source": "/api/v1/auth/verification/(.*)", "destination": "/api/v1/auth?__route=verification/$1" },
    { "source": "/api/v1/auth/mfa/login", "destination": "/api/v1/auth?__route=mfa/login" },
    { "source": "/api/v1/auth/(login|csrf|refresh|logout|change-password|me|register)", "destination": "/api/v1/auth?__route=$1" },
    { "source": "/api/v1/((?!health$|auth$|products$|categories$|settings$|admin$|orders$|wishlist$|contact$|reviews$).*)", "destination": "/api" },
    { "source": "/api/v1", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/dist/**",
      "maxDuration": 60
    },
    "api/sitemap.js": {
      "includeFiles": "backend/dist/**",
      "maxDuration": 30
    },
    "api/v1/health.js": {
      "maxDuration": 10
    },
    "api/v1/auth.js": {
      "maxDuration": 60,
      "includeFiles": "{backend/dist/**,api/_lib/auth-routes/**}"
    },
    "api/v1/products.js": {
      "maxDuration": 60,
      "includeFiles": "backend/dist/**"
    },
    "api/v1/categories.js": {
      "maxDuration": 60,
      "includeFiles": "backend/dist/**"
    },
    "api/v1/orders.js": {
      "maxDuration": 60,
      "includeFiles": "backend/dist/**"
    },
    "api/v1/wishlist.js": {
      "maxDuration": 30,
      "includeFiles": "backend/dist/**"
    },
    "api/v1/contact.js": {
      "maxDuration": 30,
      "includeFiles": "backend/dist/**"
    },
    "api/v1/reviews.js": {
      "maxDuration": 30,
      "includeFiles": "backend/dist/**"
    },
    "api/v1/settings.js": {
      "maxDuration": 30,
      "includeFiles": "backend/dist/**"
    },
    "api/v1/admin.js": {
      "maxDuration": 60,
      "includeFiles": "backend/dist/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com https:; manifest-src 'self'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=()"
        }
      ]
    }
  ]
}
