{
  "framework": "vite",
  "installCommand": "npm install --include=dev && npm install --prefix backend --include=dev && npm install --prefix frontend --include=dev",
  "buildCommand": "npm run build --prefix backend && npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/api/v1/admin/(.*)", "destination": "/api/v1/admin?__route=$1" },
    { "source": "/api/v1/products/(.*)", "destination": "/api/v1/products?__route=$1" },
    { "source": "/api/v1/categories/(.*)", "destination": "/api/v1/categories?__route=$1" },
    { "source": "/api/v1/((?!health$|db-ping$|auth/login$|auth/csrf$|auth/refresh$|products$|categories$|settings$|admin$).*)", "destination": "/api" },
    { "source": "/api/v1", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/dist/**",
      "maxDuration": 60
    },
    "api/v1/health.js": {
      "maxDuration": 10
    },
    "api/v1/db-ping.js": {
      "maxDuration": 10
    },
    "api/v1/auth/csrf.js": {
      "maxDuration": 10
    },
    "api/v1/auth/refresh.js": {
      "maxDuration": 30,
      "includeFiles": "backend/dist/**"
    },
    "api/v1/auth/login.js": {
      "maxDuration": 60,
      "includeFiles": "backend/dist/**"
    },
    "api/v1/products.js": {
      "maxDuration": 60,
      "includeFiles": "backend/dist/**"
    },
    "api/v1/categories.js": {
      "maxDuration": 60,
      "includeFiles": "backend/dist/**"
    },
    "api/v1/settings.js": {
      "maxDuration": 30,
      "includeFiles": "backend/dist/**"
    },
    "api/v1/admin.js": {
      "maxDuration": 60,
      "includeFiles": "backend/dist/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https:; manifest-src 'self'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), microphone=()"
        }
      ]
    }
  ]
}
