VITE_API_URL=/api/v1
# Optional Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
# VITE_GA_MEASUREMENT_ID=

# "Continue with Google": the OAuth client ID from Google Cloud (not secret). Also read by the
# server (api) to check Google's tokens. Leave empty to hide the Google button.
# VITE_GOOGLE_CLIENT_ID=
